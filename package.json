{
  "name": "pi-dictate",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local /talk dictation for Pi on macOS",
  "license": "MIT",
  "author": "Geet Khosla",
  "repository": { "type": "git", "url": "https://github.com/gvkhosla/pi-dictate.git" },
  "homepage": "https://github.com/gvkhosla/pi-dictate#readme",
  "bugs": { "url": "https://github.com/gvkhosla/pi-dictate/issues" },
  "engines": { "node": ">=24" },
  "keywords": ["pi-package", "dictation", "speech-to-text", "whisper", "local-first", "macos"],
  "pi": { "extensions": ["./src/index.ts"] },
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "test": "node --experimental-strip-types --test --test-timeout=15000 test/*.test.ts",
    "test:tui": "python3 test/tui-smoke.py",
    "benchmark": "node --experimental-strip-types scripts/benchmark.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": { "optional": true },
    "@earendil-works/pi-tui": { "optional": true }
  },
  "overrides": {
    "@earendil-works/pi-coding-agent": { "undici": "8.12.2" }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
